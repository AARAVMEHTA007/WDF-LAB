                </mxCell>
                <mxCell id="a1" value="A: This site was built by me as a personal project to practice HTML and web development fundamentals." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
