                </mxCell>
                <mxCell id="a2" value="A: The site is built using plain HTML5, with C++ used separately for data structures and algorithm practice." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
